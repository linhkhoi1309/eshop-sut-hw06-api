# dependencies
node_modules/

# SUT database is regenerated by scripts/seed-api-data.js before every run
sut/backend/database.sqlite
sut/backend/*.sqlite-journal
sut/backend/*.sqlite-wal
sut/backend/*.sqlite-shm

# run bookkeeping (regenerated)
scripts/.sut.pid
scripts/*.log
scripts/*.log.err
sut.log

# Newman raw output is regenerated; the graded HTML report is committed explicitly
reports/*.json
!reports/.gitkeep

# OS
Thumbs.db
.DS_Store

# local agent config (skills/ is committed, .claude/ is just a symlink into it)
.claude/
